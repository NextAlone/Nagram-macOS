// Configuration settings file format documentation can be found at:
// https://help.apple.com/xcode/#/dev745c5c974

SIMPLE_SLASH=/

WEBRTC_MAC = 1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) WEBRTC_MAC=$(WEBRTC_MAC)

// Nagram API credentials; the values live in the git-ignored Nagram.local.xcconfig.
NAGRAM_API_ID =
NAGRAM_API_HASH =
#include? "Nagram.local.xcconfig"
